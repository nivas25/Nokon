# Copy to .env.local (Next.js) or .env (scripts). Never commit real values.
# All Razorpay and Supabase service keys are server-side only.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional public Razorpay key for Checkout.js later. v1 uses Payment Link URLs, so this can stay empty.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Server only. Used by Route Handlers and scripts. Never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Optional: same Postgres for Mastra @mastra/pg (not used in v1; libSQL file is default).
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# --- Razorpay TEST mode only (rzp_test_…) ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxx
# Dashboard → Webhooks (test mode). Not the API key secret.
RAZORPAY_WEBHOOK_SECRET=xxxxxxxx
# Optional hosted-page redirect after pay. Must be a full URL if set.
RAZORPAY_CALLBACK_URL=http://localhost:3000/buyer/paid

# --- SpaceXAI / xAI (agents + screenshot parse) ---
XAI_API_KEY=xai-xxxxxxxx
# Mastra router model ids. See docs/research/versions.md
XAI_MODEL=xai/grok-4.6

# --- Mastra local snapshots ---
MASTRA_DB_URL=file:./mastra.db

# --- Scripts ---
# Set to 1 only for labelled dev-only helpers. Never for a fake paid UI button.
ALLOW_DEV_PAID=0
