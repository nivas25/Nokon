# Copy to .env.local — Never commit real values.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Razorpay (TEST mode keys) ---
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxx
RAZORPAY_CALLBACK_URL=http://localhost:3000/buyer/paid

# --- AI (OpenAI for GPT-4o-mini vision + chat) ---
OPENAI_API_KEY=sk-proj-xxxxxxxx

# --- Mastra local snapshots ---
MASTRA_DB_URL=file:./mastra.db

# --- WhatsApp Business Cloud API (Meta) ---
WHATSAPP_VERIFY_TOKEN=your_custom_verify_token
WHATSAPP_ACCESS_TOKEN=EAAxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=0000000000000000
WHATSAPP_WABA_ID=0000000000000000

# --- Shipping (Optional) ---
SHIPROCKET_API_KEY=xxxxxxxx
